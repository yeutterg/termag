# Terminalz Compose configuration. Copy this file to infra/.env.

# Release image and version. Pin TERMINALZ_VERSION in production; use latest
# only when automatic upgrades are intentional.
TERMINALZ_IMAGE=ghcr.io/yeutterg/terminalz
TERMINALZ_VERSION=latest

# Browser hostname served by Caddy and the exact externally-visible URL.
TERMINALZ_HOST=terminalz.example.com
NEXTAUTH_URL=https://terminalz.example.com

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-hex-32

# Secure default: OAuth. For a private Tailscale/WireGuard/LAN deployment,
# set this to true and set a long TERMINALZ_PASSWORD as a second gate.
TERMINALZ_TRUSTED_NETWORK=false
TERMINALZ_PASSWORD=

# Google OAuth (required when TERMINALZ_TRUSTED_NETWORK=false).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TERMINALZ_ALLOWED_EMAIL=

# Optional comma-separated browser origins for split/proxied deployments.
TERMINALZ_ALLOWED_ORIGINS=

# Enable only behind a proxy that overwrites Forwarded/X-Forwarded-For.
TERMINALZ_TRUSTED_PROXY=false

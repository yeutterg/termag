# Docker Compose env for termag-next deployments.
#
# Copy to `.env` (which is gitignored), fill in real values, then run:
#   docker compose up -d
#
# Variables flow into apps/web's container and into Caddy via docker-compose.yml.
#
# ⚠️ Default mode is auth-less (trusted-network). Only deploy this way behind
# Tailscale, WireGuard, an ssh tunnel, or a private LAN. To expose on a
# public hostname, set TERMAG_TRUSTED_NETWORK=false and fill in the OAuth
# block below. See ../README.md → Security Model.

# ─── Hostname Caddy will serve TLS for ──────────────────────────────────────
# Public hostname → Caddy auto-issues a Let's Encrypt cert.
# Tailscale hostname → use `https://<host>` and Tailscale's MagicDNS / cert.
# `localhost` → Caddy serves a local certificate; Safari may warn that it is
# not private. Use http://localhost for redirect testing or https://localhost
# for the actual app.
TERMAG_HOST=termag.example.com

# ─── NextAuth bookkeeping ───────────────────────────────────────────────────
# Must match what users actually type in the browser, including scheme + port.
NEXTAUTH_URL=https://termag.example.com

# Required by NextAuth even in trusted-network mode (it signs the session JWT).
# Generate with:  openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-hex-32

# ─── Roots the agent will project from each device ──────────────────────────
# JSON map: rootKey → absolute path on that device. The web UI uses rootKey
# as the device label in the sidebar.
TERMAG_ROOTS={"WIP":"~/WIP"}

# ─── Auth mode (default = trusted-network, no login) ────────────────────────
# Leave true (or unset) for a private deployment. Flip to false ONLY when
# you've configured the OAuth block below.
TERMAG_TRUSTED_NETWORK=true

# ─── Optional: shared password gate on top of trusted-network mode ──────────
# Thin "oops I leaked the URL" safety net. NOT a substitute for OAuth on
# a public hostname. Pick something long and random.
# TERMAG_PASSWORD=pick-a-long-random-string

# ─── Optional: Google OAuth (required for public-internet deployments) ──────
# Set TERMAG_TRUSTED_NETWORK=false above when using these.
# Get the credentials at https://console.cloud.google.com/apis/credentials
# → Create OAuth Client ID → Web application
# → Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Single email allowed past the OAuth `signIn` callback. Anything else gets
# bounced back to /login. Leave blank to disable OAuth.
# TERMAG_ALLOWED_EMAIL=

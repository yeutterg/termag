# Web — termag-next is auth-less by default. Anyone who can reach this URL
# gets a session. ONLY safe behind Tailscale, WireGuard, ssh tunnel, or a
# private LAN. Never expose this to the public internet without setting
# TERMAG_TRUSTED_NETWORK=false and configuring OAuth below.

DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
TERMAG_TRUSTED_USER_EMAIL="user@example.invalid"
TERMAG_ROOTS='{"local":"~/Projects"}'

# --- Optional: shared password gate on top of trusted-network mode ---
# Adds a single-password login screen. Useful as a thin "oops I leaked the URL"
# safety net. Not a substitute for OAuth on the public internet.
# TERMAG_PASSWORD="pick-a-long-random-string"

# --- Public-internet deployment: opt into Google OAuth ---
# TERMAG_TRUSTED_NETWORK="false"
# NEXTAUTH_SECRET="replace-with-openssl-rand-hex-32"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# TERMAG_ALLOWED_EMAIL=""

# Agent
TERMAG_URL="ws://localhost:3000/api/ws/agent"
TERMAG_AGENT_TOKEN=""
TERMAG_AGENT_ROOTS='{"local":"~/Projects"}'

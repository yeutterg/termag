# Web — secure-by-default.
#
# termag requires Google OAuth out of the box. To run auth-less behind a
# private network (Tailscale, WireGuard, ssh tunnel, LAN), opt in to
# trusted-network mode by setting TERMAG_TRUSTED_NETWORK="true". The
# broker will refuse to boot if trusted-network is on AND it's bound to
# a non-loopback interface AND TERMAG_PASSWORD is not set.

DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-hex-32"
TERMAG_TRUSTED_USER_EMAIL="user@example.invalid"
TERMAG_ROOTS='{"local":"~/Projects"}'

# --- OAuth (default) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TERMAG_ALLOWED_EMAIL=""

# --- Trusted-network mode (opt-in, replaces OAuth) ---
# Pick the bind address carefully. With HOSTNAME=127.0.0.1 you're loopback
# only and TERMAG_PASSWORD is optional (front it with Tailscale Funnel,
# Caddy + cert, etc.). With a public bind, TERMAG_PASSWORD is required and
# enforced at boot.
# TERMAG_TRUSTED_NETWORK="true"
# TERMAG_PASSWORD="pick-a-long-random-string"

# Agent
TERMAG_URL="ws://localhost:3000/api/ws/agent"
TERMAG_AGENT_TOKEN=""
TERMAG_AGENT_ROOTS='{"local":"~/Projects"}'

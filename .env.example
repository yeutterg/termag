# Local web development
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-hex-32"
TERMINALZ_BIND_HOST="127.0.0.1"
TERMINALZ_TRUSTED_NETWORK="true"
TERMINALZ_TRUSTED_USER_EMAIL="user@example.invalid"

# Optional shared password when binding beyond loopback.
# TERMINALZ_PASSWORD="pick-a-long-random-string"

# OAuth alternative
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TERMINALZ_ALLOWED_EMAIL=""

# Local native agent
TERMINALZ_URL="ws://localhost:3000/api/ws/agent"
TERMINALZ_AGENT_TOKEN=""
TERMINALZ_AGENT_ROOTS='{"local":"~/Projects"}'

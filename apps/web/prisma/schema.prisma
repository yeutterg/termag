generator client {
  provider      = "prisma-client-js"
  // node:22-bookworm-slim ships OpenSSL 3 only; Prisma's auto-detect picks
  // the openssl-1.1.x binary by default and then fails at runtime with
  // libssl.so.1.1 not found. Listing both arm64 + amd64 OpenSSL 3 targets
  // forces Prisma to ship the right engine for either Docker host arch.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?
  image       String?
  theme       String   @default("system")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects    Project[]
  agentTokens AgentToken[]
}

model AgentToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id                String   @id @default(cuid())
  name              String
  rootKey           String
  relativePath      String
  tmuxSessionName   String?
  tmuxManaged       Boolean  @default(true)
  agentType         String
  agentSpawnCommand String
  ctrlSpawnCommand  String   @default("$SHELL")
  status            String   @default("sleeping")
  // User-defined drag-and-drop ordering. Null means "no manual position
  // set" — project falls back to alphabetical sorting in listProjects.
  position          Float?
  openedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tabs     Tab[]
  sessions Session[]

  @@unique([userId, name])
  @@unique([userId, rootKey, tmuxSessionName])
  @@index([userId, position])
  @@index([userId, openedAt])
}

model Tab {
  id        String   @id @default(cuid())
  name      String
  ordinal   Int
  status    String   @default("sleeping")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  session Session?

  @@unique([projectId, ordinal])
  @@index([projectId])
}

model Session {
  id             String    @id @default(cuid())
  kind           String
  tmuxName       String
  tmuxWindowName String?
  tmuxManaged    Boolean   @default(true)
  agentType      String?
  spawnCommand   String?
  status         String    @default("sleeping")
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tabId String? @unique
  tab   Tab?    @relation(fields: [tabId], references: [id], onDelete: Cascade)

  scrollback ScrollbackChunk[]

  @@index([projectId, kind])
  @@index([tmuxName])
}

model ScrollbackChunk {
  id        String   @id @default(cuid())
  data      String
  lineCount Int
  createdAt DateTime @default(now())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

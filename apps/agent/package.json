{
  "name": "termag-agent",
  "version": "0.1.3",
  "description": "Outbound termag laptop agent. Bridges tmux clients to the termag broker over WebSocket.",
  "author": "Greg Yeutter <yeutterg@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeutterg/termag-next.git",
    "directory": "apps/agent"
  },
  "homepage": "https://github.com/yeutterg/termag-next#readme",
  "bugs": "https://github.com/yeutterg/termag-next/issues",
  "keywords": [
    "tmux",
    "websocket",
    "agent",
    "remote-development",
    "termag"
  ],
  "bin": {
    "termag": "dist/index.js",
    "termag-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "fake": "TERMAG_AGENT_FAKE=true tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.12",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

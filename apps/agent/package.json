{
  "name": "@yeutterg/agent",
  "version": "0.1.1",
  "description": "Outbound termag laptop agent — bridges tmux to the termag broker over WebSocket. No native deps.",
  "author": "Greg Yeutter <yeutterg@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeutterg/termag-next.git",
    "directory": "apps/agent"
  },
  "homepage": "https://github.com/yeutterg/termag-next#readme",
  "bugs": "https://github.com/yeutterg/termag-next/issues",
  "keywords": ["tmux", "websocket", "agent", "remote-development", "termag"],
  "bin": {
    "termag-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "fake": "TERMAG_AGENT_FAKE=true tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

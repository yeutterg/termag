class Terminalz < Formula
  desc "Lightweight agent and CLI for multi-machine terminal streaming"
  homepage "https://github.com/yeutterg/terminalz"
  version "__VERSION__"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/yeutterg/terminalz/releases/download/v__VERSION__/terminalz-v__VERSION__-aarch64-apple-darwin.tar.gz"
      sha256 "__SHA_MACOS_ARM64__"
    else
      url "https://github.com/yeutterg/terminalz/releases/download/v__VERSION__/terminalz-v__VERSION__-x86_64-apple-darwin.tar.gz"
      sha256 "__SHA_MACOS_X64__"
    end
  end

  on_linux do
    if Hardware::CPU.arm? && Hardware::CPU.is_64_bit?
      url "https://github.com/yeutterg/terminalz/releases/download/v__VERSION__/terminalz-v__VERSION__-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_LINUX_ARM64__"
    else
      url "https://github.com/yeutterg/terminalz/releases/download/v__VERSION__/terminalz-v__VERSION__-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_LINUX_X64__"
    end
  end

  def install
    bin.install "terminalz"
  end

  service do
    run [opt_bin/"terminalz"]
    keep_alive crashed: true
    process_type :background
    log_path var/"log/terminalz.log"
    error_log_path var/"log/terminalz.log"
  end

  test do
    assert_match "terminalz #{version}", shell_output("#{bin}/terminalz --version")
  end
end
